{
    "name": "PHP + MongoDB",

    "build": {
        "dockerfile": "Dockerfile"
    },

    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {}
    },

    "forwardPorts": [
        80,
        27017
    ],

    "customizations": {
        "vscode": {
            "extensions": [
                "DEVSENSE.phptools-vscode"
            ]
        }
    },

    "postCreateCommand": "composer install && docker compose up -d"
}
